<apex:page standardController="Quote" renderAs="pdf" applyHtmlTag="false" showHeader="false">
    <html>
        <head>
            <style>
                body {
                    font-family: Arial, sans-serif;
                    font-size: 12px;
                }
                h1 {
                    text-align: center;
                    font-size: 18px;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 20px;
                }
                th, td {
                    padding: 8px;
                    text-align: center;
                    border-bottom: 1px solid #ddd;
                }
                th {
                    background-color: #f2f2f2;
                    font-weight: bold;
                }
                .summary-table {
                    width: 50%;
                    float: right;
                    margin-top: 20px;
                }
                .signature-section {
                    margin-top: 30px;
                    width: 100%;
                }
                .signature-line {
                    margin-top: 10px;
                    width: 100%;
                    border-bottom: 1px solid #ccc;
                }
            </style>
        </head>
        <body>
            <h1>Megnity Technologies Pvt Ltd</h1>

            <table>
                <tr>
                    <td><b>Company Address:</b> US</td>
                    <td><b>Created Date:</b> <apex:outputText value="{!Quote.CreatedDate}"/></td>
                </tr>
                <tr>
                    <td><b>Expiration Date:</b> <apex:outputText value="{!Quote.ExpirationDate}"/></td>
                    <td><b>Quote Number:</b> <apex:outputText value="{!Quote.QuoteNumber}"/></td>
                </tr>
                <tr>
                    <td><b>Prepared By:</b> Megnity Technologies </td>
                    <td><b>Email:</b> megnity.ai</td>
                </tr>
            </table>

            <!-- Product Table -->
            <table>
                <tr>
                    <th>Product</th>
                    <th>List Price (USD)</th>
                    <th>Sales Price (USD)</th>
                    <th>Quantity</th>
                    <th>Discount (%)</th>
                    <th>Total Price (USD)</th>
                </tr>
                <apex:repeat value="{!Quote.QuoteLineItems}" var="item">
                    <tr>
                        <td><apex:outputText value="{!item.Product2.Name}"/></td>
                        <td><apex:outputText value="{!item.ListPrice}"/></td>
                        <td><apex:outputText value="{!item.UnitPrice}"/></td>
                        <td><apex:outputText value="{!item.Quantity}"/></td>
                        <td><apex:outputText value="{!item.Discount}"/></td>
                        <td><apex:outputText value="{!item.TotalPrice}"/></td>
                    </tr>
                </apex:repeat>
            </table>

            <!-- Summary Section -->
            <table class="summary-table">
                <tr>
                    <td><b>Subtotal:</b></td>
                    <td><apex:outputText value="{!Quote.Subtotal}"/></td>
                </tr>
                <tr>
                    <td><b>Discount:</b></td>
                    <td><apex:outputText value="{!Quote.Discount}"/>%</td>
                </tr>
                <tr>
                    <td><b>Total Price:</b></td>
                    <td><apex:outputText value="{!Quote.TotalPrice}"/></td>
                </tr>
                <tr>
                    <td><b>Grand Total:</b></td>
                    <td><apex:outputText value="{!Quote.GrandTotal}"/></td>
                </tr>
            </table>

            <!-- Signature Section -->
            <div class="signature-section">
                <div><b>Signature:</b> <span class="signature-line"></span></div>
                <div><b>Name:</b> <span class="signature-line"></span></div>
                <div><b>Title:</b> <span class="signature-line"></span></div>
                <div><b>Date:</b> <span class="signature-line"></span></div>
            </div>
        </body>
    </html>
</apex:page>