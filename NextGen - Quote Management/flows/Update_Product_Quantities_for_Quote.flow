<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Product_names</name>
        <label>Product names</label>
        <locationX>396</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>PNames</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_Quote_Line_Items.Product2.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_Matching_Product</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_for_Matching_Product</name>
        <label>Check for Matching Product</label>
        <locationX>396</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Quote_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Quote_Line_Items.Product2.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ProductName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Updated_Quantity</targetReference>
            </connector>
            <label>Product Selected</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Update Product Quantities for Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Product Quantities for Quote</label>
    <loops>
        <name>Loop_through_Quote_Line_Items</name>
        <label>Loop through Quote Line Items</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Quote_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Product_names</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
