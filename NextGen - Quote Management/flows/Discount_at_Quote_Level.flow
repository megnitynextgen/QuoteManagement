    <assignments>
        <name>Assign_an_updated_Quote</name>
        <label>Assign an updated Quote</label>
        <locationX>50</locationX>
        <locationY>1190</locationY>
        <assignmentItems>
            <assignToReference>QuoteDiscount</assignToReference>
            <operator>Assign</operator>
