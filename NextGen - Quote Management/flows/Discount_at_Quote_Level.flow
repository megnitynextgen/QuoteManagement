            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>updatedRecQuoteNo</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Updated_Quote.QuoteNumber</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assigning_a_Iterate_Quote_Line_Items</name>
        <label>Assigning a Iterate Quote Line Items</label>
        <locationX>138</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>ColQuotelineId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_a_Quote_Line_Items.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SubTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_a_Quote_Line_Items.Subtotal</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_a_Quote_Line_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_a_Quote_Line_item</name>
        <label>Assignment a Quote Line item</label>
        <locationX>50</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>QuoteLineIdAssign</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ColQuotelineId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SubTotalAssign</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SubTotal</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>quoteCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ColQuotelineId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colDis</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Discount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote_Line_Item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Check_a_Quote_is_Available_or_Not</name>
        <label>Check a Quote is Available or Not</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>IfQuoteNotAvailable</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please Check the Quote Number.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Quote_Line_is_Not_Available</name>
        <label>Quote Line is Not Available</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>IfQuoteLineItemnotAva</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please Check the Quote and Quote Line Items</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_the_Quote</name>
        <label>Check the Quote</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Check_a_Quote_is_Available_or_Not</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Quote Not Available</defaultConnectorLabel>
        <rules>
            <name>Quote_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Related_Quote_Line_Items</targetReference>
            </connector>
            <label>Quote Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Checking_a_Quotes_Line_Items</name>
        <label>Checking a Quotes Line Items</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Quote_Line_is_Not_Available</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Available</defaultConnectorLabel>
        <rules>
            <name>Is_Quote_Line_item_Availabe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Related_Quote_Line_Items</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_a_Quote_Line_Items</targetReference>
            </connector>
            <label>Is Quote Line item  Availabe</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Discount at Quote Leve {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Discount at Quote Level</label>
    <loops>
        <name>Iterate_a_Quote_Line_Items</name>
        <label>Iterate a Quote Line Items</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <collectionReference>Get_Quote_Related_Quote_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assigning_a_Iterate_Quote_Line_Items</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assignment_a_Quote_Line_item</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
