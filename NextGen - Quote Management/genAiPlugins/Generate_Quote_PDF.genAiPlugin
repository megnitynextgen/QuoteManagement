<?xml version="1.0" encoding="UTF-8"?>
<GenAiPlugin xmlns="http://soap.sforce.com/2006/04/metadata">
    <canEscalate>false</canEscalate>
    <description>&quot;This action generates a PDF document for a specified quote based on the provided Quote Number. Once generated, it returns a direct link to the PDF document in the form of a &apos;Download Quote PDF&apos; link, which can be shared with the customer or downloaded for reference.</description>
    <developerName>Generate_Quote_PDF</developerName>
    <genAiFunctions>
        <functionName>Generate_Quote_File</functionName>
    </genAiFunctions>
    <genAiPluginInstructions>
        <description>ALWAYS don&apos;t collect the Quote number from the in the form of natura language not in the form of variables</description>
        <developerName>instruction_alwaysdont0</developerName>
        <language>en_US</language>
        <masterLabel>instruction_alwaysdont0</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>Always the output should displayed in the following way.

📄 PDF generated for this quote:

Quote Number: xxx

Link: Click here to view the PDF

Follow this instruction strictly.</description>
        <developerName>instruction_alwaystheo1</developerName>
        <language>en_US</language>
        <masterLabel>instruction_alwaystheo1</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>Always When the user provides a quote number, generate a PDF document for the quote. Respond with a clickable link labeled &apos;Download Quote PDF&apos; that allows the user to open or download the PDF directly.</description>
        <developerName>instruction_alwayswhen2</developerName>
        <language>en_US</language>
        <masterLabel>instruction_alwayswhen2</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>NEVER display the HTML formate in the conversation for the link download</description>
        <developerName>instruction_neverdispl3</developerName>
        <language>en_US</language>
        <masterLabel>instruction_neverdispl3</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>When the user asks to generate quote pdf first ask for the quote number.</description>
        <developerName>instruction_whentheuse4</developerName>
        <language>en_US</language>
        <masterLabel>instruction_whentheuse4</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>IF the customer can apply all the changes in the same quote and then ask the generate pdf you can collect the ame quote number no need to ask the again with the another quote number .</description>
        <developerName>instruction_ifthecusto5</developerName>
        <language>en_US</language>
        <masterLabel>instruction_ifthecusto5</masterLabel>
    </genAiPluginInstructions>
    <language>en_US</language>
    <masterLabel>Generate Quote PDF</masterLabel>
    <pluginType>Topic</pluginType>
    <scope>Your Job is to Generate Quote Pdf Link to the user. Only the link in the URL Format.</scope>
</GenAiPlugin>
