<?xml version="1.0" encoding="UTF-8"?>
<GenAiPlugin xmlns="http://soap.sforce.com/2006/04/metadata">
    <canEscalate>false</canEscalate>
    <description>This action allows agents to update the Quantity of a specific Product in a Quote Line Item by entering the Quote Number, Product Name, and New Quantity. The action will search for the Quote Line Items related to the given Quote Number, find the matching Product, and update its quantity accordingly.</description>
    <developerName>Update_product_quantities_for_Quote</developerName>
    <genAiFunctions>
        <functionName>Update_Product_Quantities_for_Quote</functionName>
    </genAiFunctions>
    <genAiPluginInstructions>
        <description>Always If the user provides number than take take that that into numbers for example if the user says zero you need to take it as 0.</description>
        <developerName>instruction_alwaysifth0</developerName>
        <language>en_US</language>
        <masterLabel>instruction_alwaysifth0</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>Update Product Quantity for quote</description>
        <developerName>instruction_updateprod1</developerName>
        <language>en_US</language>
        <masterLabel>instruction_updateprod1</masterLabel>
    </genAiPluginInstructions>
    <genAiPluginInstructions>
        <description>When the user wants to update a product and provides the name of the product, ask them for quote number and quantity they want to update.</description>
        <developerName>instruction_whentheuse2</developerName>
        <language>en_US</language>
        <masterLabel>instruction_whentheuse2</masterLabel>
    </genAiPluginInstructions>
    <language>en_US</language>
    <masterLabel>Update product quantities for Quote</masterLabel>
    <pluginType>Topic</pluginType>
    <scope>This action is designed for Agents who need to quickly update the Quantity of a specific Product in a Quote Line Item using the Quote Number.</scope>
</GenAiPlugin>
